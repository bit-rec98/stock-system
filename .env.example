# Copy to `.env` (git-ignored) and replace every <placeholder>.
# Read by: docker compose, and the API when run locally (it searches parent folders for .env).

# --- SQL Server container (local development only) ---
# SA_PASSWORD: administrative login used only by the db-init step. Needs 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=<strong-sa-password>
# APP_DB_PASSWORD: password of the least-privilege `stock_app` login the API uses.
APP_DB_PASSWORD=<strong-app-db-password>

# --- API ---
# Local run (dotnet run): use the same APP_DB_PASSWORD as above.
DB_CONNECTION_STRING=Server=localhost,1433;Database=StockSystemDb;User Id=stock_app;Password=<strong-app-db-password>;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT: JWT_KEY must be random and at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_KEY=<random-key-at-least-32-characters>
JWT_ISSUER=StockSystem
JWT_AUDIENCE=StockSystemUsers
JWT_EXPIRATION_HOURS=8

# Comma-separated list of exact frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Initial admin, created on first start if it does not exist. Choose your own credentials.
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password-8+-chars-upper-lower-digit>

# true loads demo categories, suppliers and products into an empty database.
SEED_SAMPLE_DATA=true
