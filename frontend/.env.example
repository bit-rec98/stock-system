# Local development: leave empty so the Vite dev server proxies /api to the backend.
# Deployed (Netlify/Vercel): set to the public API origin, e.g. https://stock-api.example.com
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api (default http://localhost:5000)
DEV_API_PROXY_TARGET=http://localhost:5000
